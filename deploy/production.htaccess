# BEGIN O100 FRONTEND
# После HTTPS/домена, до robots и маршрутизатора Битрикса.
RewriteEngine On
RewriteRule ^blog/pochemyMi\.php/?$ /o-nas/#pochemu-my [R=301,NE,END]
RewriteRule .* - [E=REMOTE_USER:%{HTTP:Authorization}]
RewriteRule ^o100_frontend_ - [R=404,END]
RewriteRule ^(api|auth|bitrix|sale|upload|local|order)(/|$) - [L]
RewriteRule ^personal/(order|payment|profile)(/|$) - [L]
RewriteRule ^(1c_exchange|payment_callback|verification)(/|$) - [L]
RewriteRule \.php$ - [L]
RewriteCond %{QUERY_STRING} (^|&)legacy=1(&|$)
RewriteRule ^basket/?$ /basket/index.php [END]
RewriteCond %{DOCUMENT_ROOT}/o100_frontend_assets/$1 -f
RewriteRule ^assets/(.+)$ /o100_frontend_assets/$1 [END]
RewriteCond %{DOCUMENT_ROOT}/o100_frontend_current/$1 -f
RewriteRule ^(.+)$ /o100_frontend_current/$1 [END]
RewriteCond %{DOCUMENT_ROOT}/o100_frontend_current/$1/index.html -f
RewriteRule ^(.+?)/?$ /o100_frontend_current/$1/index.html [END]
RewriteRule ^$ /o100_frontend_current/index.html [END]
RewriteRule ^(basket|checkout|search)/?$ /o100_frontend_current/_shell.html [END]
RewriteRule ^catalog_[sn]/[a-zA-Z0-9_/-]+/?$ /local/tools/o100-product-fallback.php [END]
ErrorDocument 404 /local/tools/o100-frontend-404.php
# END O100 FRONTEND
