RewriteRule ^catalog_s/linzy_dlya_ochkov/progressivnye/varilux_comfort_orma_transitions_thin_crizal_easy_uv/?$ - [R=404,END]
RewriteRule ^catalog_s/linzy_dlya_ochkov/progressivnye/varilux_kh_orma_thin_crizal_sapphire_uv/?$ - [R=404,END]
RewriteRule ^catalog_s/linzy_dlya_ochkov/progressivnye/varilux_physio_3_0_orma_thin_crizal_easy_uv/?$ - [R=404,END]
RewriteRule ^catalog_s/ochki/ochki_oprava_tempo_2303_03_s_linzami_ecoplus_1_56_hmc/?$ - [R=404,END]
RewriteRule ^catalog_s/ochki/ochki_oprava_tempo_3145_03_s_linzami_ecoplus_1_56_hm/?$ - [R=404,END]
RewriteRule ^catalog_s/ochki/ochki_oprava_tempo_3173_01_s_linzami_ecoplus_1_56_hmc/?$ - [R=404,END]
RewriteRule ^catalog_s/ochki/ochki_oprava_tempo_3211_03_s_linzami_ecoplus_1_56_hmc/?$ - [R=404,END]
RewriteRule ^catalog_s/opravy/detskie_/dlya_devochek/oprava_a_matsony_d_511_51/?$ - [R=404,END]
RewriteRule ^catalog_s/opravy/detskie_/dlya_devochek/oprava_vento_016_02/?$ - [R=404,END]
RewriteRule ^catalog_s/opravy/detskie_/dlya_devochek/oprava_fantasy_1112_prozrachnaya/?$ - [R=404,END]
RewriteRule ^catalog_s/opravy/detskie_/dlya_devochek/oprava_vento_908_11/?$ - [R=404,END]
RewriteRule ^catalog_s/opravy/detskie_/dlya_malchikov/oprava_vento_908_13/?$ - [R=404,END]
RewriteRule ^catalog_s/opravy/detskie_/dlya_malchikov/oprava_vento_924_12/?$ - [R=404,END]
RewriteRule ^catalog_s/opravy/detskie_/dlya_malchikov/oprava_vento_925_12/?$ - [R=404,END]
RewriteRule ^catalog_s/opravy/muzhskie/oprava_silhouette_sil_tma_must_5515_cl_9040/?$ - [R=404,END]
RewriteRule ^catalog_s/opravy/zhenskie/oprava_la_strada_galleria_11050_16_3/?$ - [R=404,END]
RewriteRule ^catalog_s/soputstvuyushchie_tovary/aksessuary/ochistiteli_i_kapli/renu_multiplus_8_ml/?$ - [R=404,END]
RewriteRule ^catalog_s/opravy/detskie_1/dlya_devochek/oprava_fantasy_1112_prozrachnaya/?$ - [R=404,END]
RewriteRule ^catalog_s/opravy/detskie_1/oprava_fantasy_1112_prozrachnaya/?$ - [R=404,END]
# END O100 REVIEWED MISSING
RewriteRule ^(basket|checkout|search)/?$ /o100_frontend_current/_shell.html [END]
RewriteRule ^catalog_[sn]/[a-zA-Z0-9_/-]+/?$ /local/tools/o100-product-fallback.php [END]
ErrorDocument 404 /local/tools/o100-frontend-404.php
# END O100 FRONTEND

