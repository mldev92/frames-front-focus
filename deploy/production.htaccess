# BEGIN O100 FRONTEND
# После HTTPS/домена, до robots и маршрутизатора Битрикса.
RewriteEngine On
<IfModule mod_headers.c>
  # HTML всегда перепроверяется: открытая вкладка не должна оставаться на старом релизе.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  # Имена сборочных ресурсов содержат хеш, поэтому их можно кешировать надолго.
  <FilesMatch "\.(?:css|js|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
RewriteRule ^blog/pochemyMi\.php/?$ https://optika100.com/o-nas/?%{QUERY_STRING}#pochemu-my [R=301,NE,END]
RewriteRule ^catalog_s/linzy_dlya_ochkov/ofisnye/VX\x20Start_orma_crizal_prevencia_uv_rasshirenyy_diapazon_dioptriy/?$ https://optika100.com/catalog_s/linzy_dlya_ochkov/VX\%20Start_orma_crizal_prevencia_uv_rasshirenyy_diapazon_dioptriy/ [R=301,NE,END]
RewriteRule .* - [E=REMOTE_USER:%{HTTP:Authorization}]
RewriteRule ^o100_frontend_ - [R=404,END]
RewriteRule ^(api|auth|bitrix|sale|upload|local|order)(/|$) - [L]
RewriteRule ^personal/(order|payment|profile)(/|$) - [L]
RewriteRule ^(1c_exchange|payment_callback|verification)(/|$) - [L]
RewriteRule \.php$ - [L]
RewriteCond %{QUERY_STRING} (^|&)legacy=1(&|$)
RewriteRule ^basket/?$ /basket/index.php [END]
RewriteCond %{DOCUMENT_ROOT}/o100_frontend_assets/$1 -f
RewriteRule ^assets/(.+)$ /o100_frontend_assets/$1 [END]
RewriteCond %{DOCUMENT_ROOT}/o100_frontend_current/$1 -f
RewriteRule ^(.+)$ /o100_frontend_current/$1 [END]
RewriteCond %{DOCUMENT_ROOT}/o100_frontend_current/$1/index.html -f
RewriteRule ^(.+?)/?$ /o100_frontend_current/$1/index.html [END]
RewriteRule ^$ /o100_frontend_current/index.html [END]
# BEGIN O100 REVIEWED MISSING
# Не отправляем снятый товар в общую категорию через старый обработчик Bitrix.
RewriteRule ^catalog_s/kontaktnye_linzy_/prozrachnye/air_optix_aqua_6_sht/?$ - [R=404,END]
RewriteRule ^catalog_s/kontaktnye_linzy_/prozrachnye/1_day_acuvue_moist_180_sht/?$ - [R=404,END]
RewriteRule ^catalog_s/kontaktnye_linzy_/tsvetnye/freshlook_colorblends/?$ - [R=404,END]
RewriteRule ^catalog_s/kontaktnye_linzy_/tsvetnye/freshlook_colors/?$ - [R=404,END]
RewriteRule ^catalog_s/linzy_dlya_ochkov/odnofokalnye/as_styles_crizal_easy_uv/?$ - [R=404,END]
RewriteRule ^catalog_s/linzy_dlya_ochkov/odnofokalnye/orma_transitions_vii_crizal_alize_uv/?$ - [R=404,END]
RewriteRule ^catalog_s/linzy_dlya_ochkov/odnofokalnye/orma_transitions_xtractive_crizal_alize_uv/?$ - [R=404,END]
RewriteRule ^catalog_s/linzy_dlya_ochkov/odnofokalnye/orma_transitions_xtractive_supra/?$ - [R=404,END]
RewriteRule ^catalog_s/linzy_dlya_ochkov/ofisnye/VX\x20Start_orma_crizal_easy_uv_ot_0_75_do_3_00/?$ - [R=404,END]
RewriteRule ^catalog_s/linzy_dlya_ochkov/prizmaticheskie/1_50_cr39_multi_coat/?$ - [R=404,END]
